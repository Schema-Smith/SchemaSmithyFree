[{"Owner": 217, "Title": "Documents", "Status": 2, "rowguid": "ff510af1-2568-11f1-ba38-b2c66e4e39ef", "Document": null, "FileName": "Documents", "Revision": "0", "FolderFlag": 1, "ChangeNumber": 0, "DocumentNode": "/", "ModifiedDate": "2017-12-13T13:58:04", "FileExtension": "", "DocumentSummary": null}, {"Owner": 217, "Title": "Overview", "Status": 2, "rowguid": "ff511272-2568-11f1-ba38-b2c66e4e39ef", "Document": null, "FileName": "Overview", "Revision": "0", "FolderFlag": 1, "ChangeNumber": 0, "DocumentNode": "/1/", "ModifiedDate": "2017-12-13T13:58:04", "FileExtension": "", "DocumentSummary": null}, {"Owner": 219, "Title": "Introduction 1", "Status": 2, "rowguid": "ff51178a-2568-11f1-ba38-b2c66e4e39ef", "Document": "", "FileName": "Introduction 1.doc", "Revision": "4", "FolderFlag": 0, "ChangeNumber": 28, "DocumentNode": "/1/1/", "ModifiedDate": "2013-05-30T00:00:00", "FileExtension": ".doc", "DocumentSummary": null}, {"Owner": 220, "Title": "Repair and Service Guidelines", "Status": 2, "rowguid": "ff530f13-2568-11f1-ba38-b2c66e4e39ef", "Document": "", "FileName": "Repair and Service Guidelines.doc", "Revision": "0", "FolderFlag": 0, "ChangeNumber": 8, "DocumentNode": "/1/2/", "ModifiedDate": "2008-03-31T00:00:00", "FileExtension": ".doc", "DocumentSummary": "It is important that you maintain your bicycle and keep it in good repair. Detailed repair and service guidelines are provided along with instructions for adjusting the tightness of the suspension fork.\r\n\r\n"}, {"Owner": 217, "Title": "Maintenance", "Status": 2, "rowguid": "ff55e685-2568-11f1-ba38-b2c66e4e39ef", "Document": null, "FileName": "Maintenance", "Revision": "0", "FolderFlag": 1, "ChangeNumber": 0, "DocumentNode": "/2/", "ModifiedDate": "2017-12-13T13:58:04", "FileExtension": "", "DocumentSummary": null}, {"Owner": 219, "Title": "Crank Arm and Tire Maintenance", "Status": 1, "rowguid": "ff55ee77-2568-11f1-ba38-b2c66e4e39ef", "Document": "", "FileName": "Crank Arm and Tire Maintenance.doc", "Revision": "0", "FolderFlag": 0, "ChangeNumber": 0, "DocumentNode": "/2/1/", "ModifiedDate": "2012-10-19T09:56:38", "FileExtension": ".doc", "DocumentSummary": null}, {"Owner": 219, "Title": "Lubrication Maintenance", "Status": 1, "rowguid": "ff5817a5-2568-11f1-ba38-b2c66e4e39ef", "Document": "", "FileName": "Lubrication Maintenance.doc", "Revision": "2", "FolderFlag": 0, "ChangeNumber": 11, "DocumentNode": "/2/2/", "ModifiedDate": "2013-05-30T00:00:00", "FileExtension": ".doc", "DocumentSummary": "Guidelines and recommendations for lubricating the required components of your Adventure Works Cycles bicycle. Component lubrication is vital to ensuring a smooth and safe ride and should be part of your standard maintenance routine. Details instructions are provided for each bicycle component requiring regular lubrication including the frequency at which oil or grease should be applied. \r\n"}, {"Owner": 217, "Title": "Assembly", "Status": 2, "rowguid": "ff59784e-2568-11f1-ba38-b2c66e4e39ef", "Document": null, "FileName": "Assembly", "Revision": "0", "FolderFlag": 1, "ChangeNumber": 0, "DocumentNode": "/3/", "ModifiedDate": "2017-12-13T13:58:04", "FileExtension": "", "DocumentSummary": null}, {"Owner": 220, "Title": "Front Reflector Bracket and Reflector Assembly 3", "Status": 2, "rowguid": "ff597bbc-2568-11f1-ba38-b2c66e4e39ef", "Document": "", "FileName": "Front Reflector Bracket and Reflector Assembly 3.doc", "Revision": "3", "FolderFlag": 0, "ChangeNumber": 25, "DocumentNode": "/3/1/", "ModifiedDate": "2012-04-30T00:00:00", "FileExtension": ".doc", "DocumentSummary": null}, {"Owner": 220, "Title": "Front Reflector Bracket Installation", "Status": 2, "rowguid": "ff5b91c1-2568-11f1-ba38-b2c66e4e39ef", "Document": null, "FileName": "Front Reflector Bracket Installation.doc", "Revision": "1", "FolderFlag": 0, "ChangeNumber": 15, "DocumentNode": "/3/2/", "ModifiedDate": "2012-04-30T00:00:00", "FileExtension": ".doc", "DocumentSummary": "Reflectors are vital safety components of your bicycle. Always ensure your front and back reflectors are clean and in good repair. Detailed instructions and illustrations are included should you need to replace the front reflector or front reflector bracket of your Adventure Works Cycles bicycle.\r\n\r\n"}, {"Owner": 220, "Title": "Installing Replacement Pedals", "Status": 2, "rowguid": "ff5f6b01-2568-11f1-ba38-b2c66e4e39ef", "Document": "", "FileName": "Installing Replacement Pedals.doc", "Revision": "0", "FolderFlag": 0, "ChangeNumber": 32, "DocumentNode": "/3/3/", "ModifiedDate": "2012-04-30T00:00:00", "FileExtension": ".doc", "DocumentSummary": "Detailed instructions for replacing pedals with Adventure Works Cycles replacement pedals.  Instructions are applicable to all Adventure Works Cycles bicycle models and replacement pedals. Use only Adventure Works Cycles parts when replacing worn or broken components. \r\n"}, {"Owner": 219, "Title": "Seat Assembly", "Status": 2, "rowguid": "ff6156fe-2568-11f1-ba38-b2c66e4e39ef", "Document": null, "FileName": "Seat Assembly.doc", "Revision": "8", "FolderFlag": 0, "ChangeNumber": 55, "DocumentNode": "/3/4/", "ModifiedDate": "2013-04-30T00:00:00", "FileExtension": ".doc", "DocumentSummary": "Worn or damaged seats can be easily replaced following these simple instructions.  Instructions are applicable to these  Adventure Works Cycles models: Mountain 100 through Mountain 500. Use only Adventure Works Cycles parts when replacing worn or broken components. \r\n\r\n"}, {"Owner": 220, "Title": "Training Wheels 2", "Status": 3, "rowguid": "ff63719f-2568-11f1-ba38-b2c66e4e39ef", "Document": "", "FileName": "Training Wheels 2.doc", "Revision": "1", "FolderFlag": 0, "ChangeNumber": 288, "DocumentNode": "/3/5/", "ModifiedDate": "2013-05-30T00:00:00", "FileExtension": ".doc", "DocumentSummary": null}]