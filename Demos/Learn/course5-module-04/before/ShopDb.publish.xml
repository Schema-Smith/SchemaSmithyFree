<?xml version="1.0" encoding="utf-8"?>
<!--
  READ-ONLY reference — an SSDT publish profile, the kind you pass to
  `SqlPackage /Action:Publish`. It bundles the target connection with the
  deploy-time switches (drop objects not in source, block on data loss, and so
  on). In SchemaSmith these settings move into Product.json / quench config —
  see the lesson's mapping table. You do not run this in the lab.
-->
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <TargetDatabaseName>shop_from_dacpac</TargetDatabaseName>
    <TargetConnectionString>Data Source=localhost,11433;Initial Catalog=shop_from_dacpac;User ID=sa;Password=Learn!Passw0rd;Trust Server Certificate=True</TargetConnectionString>
    <BlockOnPossibleDataLoss>True</BlockOnPossibleDataLoss>
    <DropObjectsNotInSource>True</DropObjectsNotInSource>
    <CreateNewDatabase>False</CreateNewDatabase>
  </PropertyGroup>
</Project>
