MYSQL_ROOT_PASSWORD=demo_root_pwd
MYSQL_USER=demo_user
MYSQL_PASSWORD=demo_password

# MySQL image. Unlike the other demos, this default is an EXACT pin on purpose: the demo
# is about pt-osc/SchemaSmith coexistence, and percona-toolkit's compatibility with a given
# MySQL build is the thing under test. Override only if you are deliberately testing another
# pairing, and expect pt-osc itself — not SchemaSmith — to be what breaks.
MYSQL_IMAGE="mysql:9.7.0"
