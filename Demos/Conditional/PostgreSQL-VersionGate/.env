POSTGRES_USER=demo_user
POSTGRES_PASSWORD=demo_password

# The two sides of the version gate. The demo's whole point is the CONTRAST between
# them, so keep PG_OLD below PG18 and PG_NEW at or above it — the gated column is
# `current_setting('server_version_num')::int >= 180000`. Override to try other pairs
# (e.g. PG_OLD_IMAGE="postgres:12" to see the gate hold across a wider span).
# Note: the compose service names (pg15 / pg18) reflect the DEFAULTS, not any override.
PG_OLD_IMAGE="postgres:15"
PG_NEW_IMAGE="postgres:18"
