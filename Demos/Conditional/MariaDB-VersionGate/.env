MARIADB_ROOT_PASSWORD=demo_root_pwd
MARIADB_USER=demo_user
MARIADB_PASSWORD=demo_password

# The two sides of the version gate. The demo's whole point is the CONTRAST between
# them, so keep MARIADB_OLD below 10.7 and MARIADB_NEW at or above it — the gated
# UUID column landed in MariaDB 10.7.
# Note: the compose service names (mariadb10 / mariadb11) reflect the DEFAULTS, not
# any override. 10.6 is also SchemaSmith's MariaDB floor, which is why it is the old side.
MARIADB_OLD_IMAGE="mariadb:10.6"
MARIADB_NEW_IMAGE="mariadb:11.4"
