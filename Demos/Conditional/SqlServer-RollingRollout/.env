# SQL Server image all three tenant databases run on. This demo is a STATE gate, not a
# version gate — one instance, one version — so a single override is all it needs.
# Requires columnstore index support (SQL Server 2014+; 2016+ for the nonclustered form).
MSSQL_IMAGE="mcr.microsoft.com/mssql/server:2022-latest"
