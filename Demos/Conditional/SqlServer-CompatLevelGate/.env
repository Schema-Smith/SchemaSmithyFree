MSSQL_SA_PASSWORD=Demo_StrongPassword_2026!

# ONE SQL Server instance hosts both databases — this demo gates on database
# COMPATIBILITY LEVEL, not on server version, so a single image is the whole point.
# Must be SQL Server 2022 (16.x) or later: the modern side uses GENERATE_SERIES,
# which requires compatibility level 160.
MSSQL_IMAGE="mcr.microsoft.com/mssql/server:2022-latest"
