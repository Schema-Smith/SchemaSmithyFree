MYSQL_ROOT_PASSWORD=demo_root_pwd
MYSQL_USER=demo_user
MYSQL_PASSWORD=demo_password

# The two sides of the version gate. The demo's whole point is the CONTRAST between
# them, so keep MYSQL_OLD below MySQL 9 and MYSQL_NEW at or above it — the gated
# VECTOR column is `CAST(SUBSTRING_INDEX(VERSION(), '.', 1) AS UNSIGNED) >= 9`.
# Override to try other pairs (e.g. MYSQL_OLD_IMAGE="mysql:5.7").
# Note: the compose service names (mysql8 / mysql9) reflect the DEFAULTS, not any override.
MYSQL_OLD_IMAGE="mysql:8.0"
MYSQL_NEW_IMAGE="mysql:9"
