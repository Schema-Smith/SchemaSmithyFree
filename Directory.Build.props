<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>2.3.0</Version>
    <!-- ICU runtime version bundled with self-contained Linux publish output of CLI tools.
         Single source of truth — referenced by Directory.Packages.props, the three CLI csprojs'
         AppLocalIcu RuntimeHostConfigurationOption, and the release.yml ICU_VERSION env var
         which feeds nfpm.yaml.template. Bump in lockstep with the Microsoft.ICU.ICU4C.Runtime
         package version. -->
    <IcuVersion>72.1.0.3</IcuVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- SonarAnalyzer adoption is deliberate (see the SonarAnalyzer.CSharp reference below): the
         46 rules the current tree trips are held as warnings (visible in every build) rather than
         errors while they are triaged. Rules get FIXED or intentionally suppressed (.editorconfig
         severity=none), then the curated survivors are REMOVED from this list to ratchet them to
         error (severity up only, DoD #10). This list should shrink to empty. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);S1066;S108;S1104;S1118;S112;S1144;S1168;S1172;S125;S127;S1450;S1481;S1643;S2077;S2094;S2139;S2178;S2325;S2344;S2365;S2386;S2479;S2486;S2629;S2699;S2925;S2955;S3220;S3260;S3267;S3358;S3871;S3878;S3881;S3887;S3928;S3973;S4144;S4487;S6444;S6562;S6608;S6610;S6612;S6617;S6667</WarningsNotAsErrors>
    <LangVersion>latest</LangVersion>
    <Configurations>Debug;Release;Demo</Configurations>
    <Company>SchemaSmith Contributors</Company>
    <Authors>SchemaSmith Contributors</Authors>
    <Copyright>© SchemaSmith Contributors. Licensed under the SSCL v2.0</Copyright>
  </PropertyGroup>

  <!-- Static-analysis quality gate: SonarAnalyzer runs inside every `dotnet build` (local + CI,
       no separate job). PrivateAssets=all keeps it dev-only — never flows into the packed
       SchemaSmith.Schema NuGet. Being introduced deliberately: measure the finding inventory,
       triage to a curated set, then ratchet the curated rules to error (severity up only). -->
  <ItemGroup>
    <PackageReference Include="SonarAnalyzer.CSharp">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Strip PDB files from Release/Demo publish output so ZIPs and MSIs never include them -->
  <PropertyGroup Condition="'$(Configuration)' != 'Debug'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

</Project>
