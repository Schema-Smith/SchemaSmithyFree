<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>2.0.0</Version>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>latest</LangVersion>
    <Configurations>Debug;Release;Demo</Configurations>
    <Company>SchemaSmith Contributors</Company>
    <Authors>SchemaSmith Contributors</Authors>
    <Copyright>© SchemaSmith Contributors. Licensed under the SSCL v2.0</Copyright>
    <!-- Run without ICU so self-contained publish works on minimal Linux containers
         (slim Docker images, hardened distros) that ship without libicu. Identifier
         comparison in this codebase is ASCII-dominated; invariant culture provides
         a stable, locale-independent collation that matches our schema-naming domain. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- Strip PDB files from Release/Demo publish output so ZIPs and MSIs never include them -->
  <PropertyGroup Condition="'$(Configuration)' != 'Debug'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

</Project>
